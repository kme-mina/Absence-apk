{
  "name": "hasr-alghiyab-apk",
  "version": "1.0.0",
  "private": true,
  "description": "حصر الغياب والتواصل الذكي مع أولياء الأمور — نظام ترخيص APK موحّد (Ed25519، ربط بالجهاز، Offline بالكامل)",
  "scripts": {
    "build:apk-web": "node scripts/build-variants.js apk",
    "build:trial-apk": "node scripts/build-variants.js trial-apk",
    "build:all": "node scripts/build-variants.js all",
    "config:paid": "node scripts/write-capacitor-config.js --variant=paid",
    "config:trial": "node scripts/write-capacitor-config.js --variant=trial",
    "test": "node tests/test_e2e.js && node tests/test_admin.js && node tests/test_trial.js && node tests/test_whatsapp_queue.js",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/device": "^6.0.1",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/browser": "^6.0.3",
    "capacitor-secure-storage-plugin": "^0.10.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
